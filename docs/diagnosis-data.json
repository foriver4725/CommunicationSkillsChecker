  "questions": [
    { "id": "q01", "text": "相手や場の雰囲気を見て、どう振る舞うべきか判断できる。", "imageUrl": "https://picsum.photos/seed/comm-q01/640/420", "axisWeights": { "context": 1 }, "reverse": true },
    { "id": "q02", "text": "相手が雑談をしたいのか、結論を求めているのかを感じ取れる。", "imageUrl": "https://picsum.photos/seed/comm-q02/640/420", "axisWeights": { "context": 1 }, "reverse": true },
    { "id": "q03", "text": "会話が始まる前から、強い緊張や不安を感じることが多い。", "imageUrl": "https://picsum.photos/seed/comm-q03/640/420", "axisWeights": { "emotion": 1 } },
    { "id": "q04", "text": "初対面や目上の相手だと、頭が真っ白になりやすい。", "imageUrl": "https://picsum.photos/seed/comm-q04/640/420", "axisWeights": { "emotion": 0.7, "context": 0.3 } },
    { "id": "q05", "text": "会話の中で、何を話題にすればよいか思いつかないことが多い。", "imageUrl": "https://picsum.photos/seed/comm-q05/640/420", "axisWeights": { "topic": 1 } },
    { "id": "q06", "text": "会話を広げるためのネタを自然に思いつける。", "imageUrl": "https://picsum.photos/seed/comm-q06/640/420", "axisWeights": { "topic": 1 }, "reverse": true },
    { "id": "q07", "text": "相手の話に対して、何を返せばいいか迷うことが多い。", "imageUrl": "https://picsum.photos/seed/comm-q07/640/420", "axisWeights": { "response": 1 } },
    { "id": "q08", "text": "相手の発言に対して、自然に質問や返答を思いつける。", "imageUrl": "https://picsum.photos/seed/comm-q08/640/420", "axisWeights": { "response": 1 }, "reverse": true },
    { "id": "q09", "text": "頭の中では考えているのに、うまく言葉にできない。", "imageUrl": "https://picsum.photos/seed/comm-q09/640/420", "axisWeights": { "expression": 1 } },
    { "id": "q10", "text": "言いたいことはあるが、適切な表現が見つからず止まってしまう。", "imageUrl": "https://picsum.photos/seed/comm-q10/640/420", "axisWeights": { "expression": 1 } },
    { "id": "q11", "text": "伝えたい内容を順序立てて話せる。", "imageUrl": "https://picsum.photos/seed/comm-q11/640/420", "axisWeights": { "structure": 1 }, "reverse": true },
    { "id": "q12", "text": "話している途中で、自分が何を言いたいのか分からなくなることがある。", "imageUrl": "https://picsum.photos/seed/comm-q12/640/420", "axisWeights": { "structure": 1 } },
    { "id": "q13", "text": "会話に入るタイミングがつかめず、発言を見送ることが多い。", "imageUrl": "https://picsum.photos/seed/comm-q13/640/420", "axisWeights": { "timing": 0.7, "context": 0.3 } },
    { "id": "q14", "text": "話し始めるべき場面で、ためらってしまうことが多い。", "imageUrl": "https://picsum.photos/seed/comm-q14/640/420", "axisWeights": { "timing": 0.6, "emotion": 0.4 } },
    { "id": "q15", "text": "緊張すると、声が出にくくなったり言葉が詰まったりする。", "imageUrl": "https://picsum.photos/seed/comm-q15/640/420", "axisWeights": { "emotion": 0.8, "expression": 0.2 } },
    { "id": "q16", "text": "会話中にミスを恐れて、言いたいことがあっても控えてしまう。", "imageUrl": "https://picsum.photos/seed/comm-q16/640/420", "axisWeights": { "emotion": 0.7, "timing": 0.3 } },
    { "id": "q17", "text": "人と話す機会が少なく、慣れていないと感じる。", "imageUrl": "https://picsum.photos/seed/comm-q17/640/420", "axisWeights": { "experience": 1 } },
    { "id": "q18", "text": "会話で『うまく話せた』と感じる経験があまりない。", "imageUrl": "https://picsum.photos/seed/comm-q18/640/420", "axisWeights": { "experience": 1 } },
    { "id": "q19", "text": "会話を重ねることで、少しずつ上達している実感がある。", "imageUrl": "https://picsum.photos/seed/comm-q19/640/420", "axisWeights": { "experience": 1 }, "reverse": true },
    { "id": "q20", "text": "人と話すことに、ある程度慣れている。", "imageUrl": "https://picsum.photos/seed/comm-q20/640/420", "axisWeights": { "experience": 1 }, "reverse": true },
    { "id": "q21", "text": "相手に合わせて、話し方や言葉選びを調整できる。", "imageUrl": "https://picsum.photos/seed/comm-q21/640/420", "axisWeights": { "context": 0.5, "expression": 0.5 }, "reverse": true },
    { "id": "q22", "text": "会話の途中で、相手が退屈していそうかどうかを察知できる。", "imageUrl": "https://picsum.photos/seed/comm-q22/640/420", "axisWeights": { "context": 1 }, "reverse": true },
    { "id": "q23", "text": "沈黙が続くと、焦りが強くなる。", "imageUrl": "https://picsum.photos/seed/comm-q23/640/420", "axisWeights": { "emotion": 0.5, "timing": 0.5 } },
    { "id": "q24", "text": "相手の話の意図をつかみ損ねて、返答に困ることがある。", "imageUrl": "https://picsum.photos/seed/comm-q24/640/420", "axisWeights": { "response": 0.6, "context": 0.4 } },
    { "id": "q25", "text": "聞いた内容を踏まえて、自分の意見や感想を返すのが得意だ。", "imageUrl": "https://picsum.photos/seed/comm-q25/640/420", "axisWeights": { "response": 1 }, "reverse": true },
    { "id": "q26", "text": "長く話そうとすると、話の筋道が崩れやすい。", "imageUrl": "https://picsum.photos/seed/comm-q26/640/420", "axisWeights": { "structure": 1 } },
    { "id": "q27", "text": "短くても、要点を押さえて伝えられる。", "imageUrl": "https://picsum.photos/seed/comm-q27/640/420", "axisWeights": { "structure": 0.5, "expression": 0.5 }, "reverse": true },
    { "id": "q28", "text": "思いついたことを、その場で言葉にするのが苦手だ。", "imageUrl": "https://picsum.photos/seed/comm-q28/640/420", "axisWeights": { "expression": 0.7, "timing": 0.3 } },
    { "id": "q29", "text": "複数人の会話では、発言のタイミングがさらに難しく感じる。", "imageUrl": "https://picsum.photos/seed/comm-q29/640/420", "axisWeights": { "timing": 0.6, "context": 0.4 } },
    { "id": "q30", "text": "多少うまくいかなくても、次の会話でまた試してみようと思える。", "imageUrl": "https://picsum.photos/seed/comm-q30/640/420", "axisWeights": { "experience": 0.7, "emotion": 0.3 }, "reverse": true },
    { "id": "q31", "text": "相手の話を聞きながら、返答を考えるのが難しい。", "imageUrl": "https://picsum.photos/seed/comm-q31/640/420", "axisWeights": { "response": 0.6, "topic": 0.4 } },
    { "id": "q32", "text": "雑談では特に、何を言えばよいか分からなくなる。", "imageUrl": "https://picsum.photos/seed/comm-q32/640/420", "axisWeights": { "topic": 0.8, "context": 0.2 } }
  ]
}
